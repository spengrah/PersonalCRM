#!/bin/bash
# Fast, path-selected static checks. Required test suites run in PR CI.
# Resolve the pushing worktree even when core.hooksPath points elsewhere.
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "Pre-push: cannot resolve pushing worktree" >&2
  exit 1
}
CONFIG_FILE=".ai/pre-push.json"
FILTERS_FILE="path-filters.yml"

file_in_group() {
  local file="$1" group="$2"
  [[ ! -f "$FILTERS_FILE" ]] && return 1
  local in_group=0
  while IFS= read -r line; do
    # Top-level key (column 0, "name:") — enter/exit the target group.
    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*): ]]; then
      if [[ "${BASH_REMATCH[1]}" == "$group" ]]; then in_group=1; else in_group=0; fi
      continue
    fi
    [[ "$in_group" -eq 0 ]] && continue
    # Pattern line "  - 'glob'".
    if [[ "$line" =~ ^[[:space:]]*-[[:space:]]+(.+)$ ]]; then
      local pattern; pattern=$(echo "${BASH_REMATCH[1]}" | tr -d "'\"")
      if [[ "$pattern" == *"*"* ]]; then
        # Convert glob to regex: ** = .*, * = [^/]*
        local regex="${pattern//\*\*/__DOUBLESTAR__}"
        regex="${regex//\*/$'[^/]*'}"
        regex="${regex//__DOUBLESTAR__/.*}"
        [[ "$file" =~ ^${regex}$ ]] && return 0
      elif [[ "$file" == "$pattern" ]]; then
        return 0
      fi
    fi
  done < "$FILTERS_FILE"
  return 1
}

# any_file_in_groups <newline-file-list> <group...>: 0 if any file is in any group.
# If the filters file is missing, conservatively select all groups.
any_file_in_groups() {
  local changed_files="$1"; shift
  [[ -z "$changed_files" ]] && return 1
  [[ ! -f "$FILTERS_FILE" ]] && return 0
  while IFS= read -r file; do
    local g
    for g in "$@"; do
      file_in_group "$file" "$g" && return 0
    done
  done <<< "$changed_files"
  return 1
}


refs_all_target_main() {
  [[ -n "$1" ]] || return 1
  awk 'NF { if (NF != 4 || $3 != "refs/heads/main") bad=1; count++ }
       END { exit (!count || bad) }' <<< "$1"
}

# Existing refs use the actual remote SHA, including force-push reversions.
# Disable rename detection so both the old and new paths select checks.
# New branches compare with the locally available development base; no fetch.
pushed_files() {
  local refs="$1" remote="${2:-origin}" local_ref local_sha remote_ref remote_sha base
  local zero="0000000000000000000000000000000000000000"
  if [[ -z "$refs" ]]; then
    base=$(git merge-base HEAD "$remote/develop") || return 1
    git diff --name-only --no-renames "$base" HEAD
    return
  fi
  while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -n "$local_ref" ]] || continue
    [[ "$local_sha" == "$zero" ]] && continue
    base="$remote_sha"
    if [[ "$base" == "$zero" ]]; then
      base=$(git merge-base "$local_sha" "$remote/develop") || return 1
    fi
    git diff --name-only --no-renames "$base" "$local_sha" || return 1
  done <<< "$refs"
}

check_selected() {
  local files="$1"; shift
  # Changes to check configuration exercise every retained check.
  if grep -qxF -e '.ai/pre-push.json' -e 'scripts/hooks/pre-push' -e 'path-filters.yml' <<< "$files"; then
    return 0
  fi
  [[ "$#" -eq 0 ]] || any_file_in_groups "$files" "$@"
}

check_frontend_format() {
  local file full=false
  local paths=()
  while IFS= read -r file; do
    case "$file" in
      frontend/.prettier*|frontend/prettier.config.*|frontend/package.json|frontend/bun.lock*)
        full=true ;;
    esac
    # Prefixing with ./ also keeps filenames from being interpreted as options.
    if [[ "$file" == frontend/* && -f "$file" && ! -L "$file" ]]; then
      paths+=("./${file#frontend/}")
    fi
  done <<< "$1"
  if [[ "$full" == true ]]; then
    (cd frontend && ./node_modules/.bin/prettier --check .)
  elif [[ "${#paths[@]}" -gt 0 ]]; then
    (cd frontend && ./node_modules/.bin/prettier --check --ignore-unknown "${paths[@]}")
  else
    echo "No changed frontend files to format-check."
  fi
}

run_checks() {
  local files="$1" entry name command started group failed=0
  local groups=()
  jq -e '.checks | type == "array" and length > 0' "$CONFIG_FILE" >/dev/null || return 1
  while IFS= read -r entry; do
    name=$(jq -er '.name' <<< "$entry") || return 1
    command=$(jq -er '.command' <<< "$entry") || return 1
    groups=()
    while IFS= read -r group; do
      [[ -n "$group" ]] && groups+=("$group")
    done < <(jq -r '.groups[]?' <<< "$entry")
    if ! check_selected "$files" "${groups[@]}"; then
      echo "  SKIP $name (no relevant changes)"
      continue
    fi
    started=$SECONDS
    echo "  -> $name"
    if ( eval "$command" ); then
      echo "  OK $name ($((SECONDS - started))s)"
    else
      echo "  FAIL $name ($((SECONDS - started))s)" >&2
      failed=1
    fi
  done < <(jq -c '.checks[]' "$CONFIG_FILE")
  return "$failed"
}

if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  return 0
fi

set -e
cd "$PROJECT_ROOT"
if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "Refusing to gate a worktree without $CONFIG_FILE" >&2
  exit 1
fi
refs=""
[[ -t 0 ]] || refs="$(cat)"
if refs_all_target_main "$refs"; then
  echo "Pre-push: promotion to main -> skipping local checks (content gated on develop CI)."
  exit 0
fi
files=$(pushed_files "$refs" "${1:-origin}") || {
  echo "Pre-push: cannot resolve pushed changes; ensure the remote SHAs and development base are available locally." >&2
  exit 1
}
echo "Pre-push: Running static checks..."
started=$SECONDS
run_checks "$files"
echo "OK: Pre-push checks passed ($((SECONDS - started))s)."
