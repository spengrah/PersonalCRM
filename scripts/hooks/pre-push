#!/bin/bash
# Unified pre-push hook: lint, swift (mac-daemon), test (parallel execution)
#
# Reads configuration from .ai/pre-push.json
# Runs enabled checks; blocks push if any required check fails
#
# To bypass (not recommended): git push --no-verify

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

CONFIG_FILE=".ai/pre-push.json"

# path-filters.yml is the single source of truth (shared with CI's dorny filter).
FILTERS_FILE="path-filters.yml"

# Check Claude review log for HEAD. Replaces the prior CI claude-review job —
# /review-head writes the verdict to .ai/log/review/<HEAD-sha>.md, and the push
# is allowed only if that file contains "RESULT=PASS".
# Bypass with `git push --no-verify` if you really need to skip.
check_review_log() {
  local enabled
  enabled=$(jq -r '.review.enabled // false' "$CONFIG_FILE")
  if [[ "$enabled" != "true" ]]; then
    return 0
  fi

  local head_sha
  head_sha=$(git rev-parse HEAD)
  local review_file=".ai/log/review/${head_sha}.md"

  if [[ ! -f "$review_file" ]]; then
    echo "" >&2
    echo "==============================================================" >&2
    echo "FAILED: No Claude review found for HEAD (${head_sha:0:12})" >&2
    echo "Expected: $review_file" >&2
    echo "Run /review-head before pushing (or use --no-verify to skip)." >&2
    echo "==============================================================" >&2
    exit 1
  fi

  if ! grep -q '^RESULT=PASS$' "$review_file"; then
    echo "" >&2
    echo "==============================================================" >&2
    echo "FAILED: Claude review for HEAD did not pass" >&2
    echo "File:  $review_file" >&2
    echo "Address findings and re-run /review-head (HEAD must change)." >&2
    echo "==============================================================" >&2
    exit 1
  fi

  echo "  [review] OK Claude review of ${head_sha:0:12}" >&2
}

# Run lint commands
run_lint() {
  local enabled=$(jq -r '.lint.enabled // false' "$CONFIG_FILE")
  if [[ "$enabled" != "true" ]]; then
    echo "SKIP" > "$LINT_RESULT"
    return
  fi

  local count=$(jq '.lint.commands | length' "$CONFIG_FILE")
  if [[ "$count" -eq 0 ]]; then
    echo "SKIP" > "$LINT_RESULT"
    return
  fi

  local failed=0
  for i in $(seq 0 $((count - 1))); do
    local name=$(jq -r ".lint.commands[$i].name" "$CONFIG_FILE")
    local cmd=$(jq -r ".lint.commands[$i].command" "$CONFIG_FILE")
    local optional=$(jq -r ".lint.commands[$i].optional // false" "$CONFIG_FILE")

    echo "  [lint] -> $name" >&2
    if eval "$cmd" >/dev/null 2>&1; then
      echo "  [lint] OK $name" >&2
    else
      if [[ "$optional" == "true" ]]; then
        echo "  [lint] WARN $name (optional)" >&2
      else
        echo "  [lint] FAIL $name" >&2
        failed=1
      fi
    fi
  done

  if [[ "$failed" -eq 1 ]]; then
    echo "FAIL" > "$LINT_RESULT"
  else
    echo "PASS" > "$LINT_RESULT"
  fi
}

# file_in_group <file> <group>: true (0) if <file> matches any glob under the
# <group:> top-level key in path-filters.yml. Group-aware: only patterns inside
# the requested group are considered. Returns 1 (no match) when the filters file
# is absent — "always run" is meaningless per-group; the absent-file fail-safe
# lives in any_file_in_groups instead.
file_in_group() {
  local file="$1" group="$2"
  [[ ! -f "$FILTERS_FILE" ]] && return 1
  local in_group=0
  while IFS= read -r line; do
    # Top-level key (column 0, "name:") — enter/exit the target group.
    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*): ]]; then
      if [[ "${BASH_REMATCH[1]}" == "$group" ]]; then in_group=1; else in_group=0; fi
      continue
    fi
    [[ "$in_group" -eq 0 ]] && continue
    # Pattern line "  - 'glob'".
    if [[ "$line" =~ ^[[:space:]]*-[[:space:]]+(.+)$ ]]; then
      local pattern; pattern=$(echo "${BASH_REMATCH[1]}" | tr -d "'\"")
      if [[ "$pattern" == *"*"* ]]; then
        # Convert glob to regex: ** = .*, * = [^/]*
        local regex="${pattern//\*\*/__DOUBLESTAR__}"
        regex="${regex//\*/$'[^/]*'}"
        regex="${regex//__DOUBLESTAR__/.*}"
        [[ "$file" =~ ^${regex}$ ]] && return 0
      elif [[ "$file" == "$pattern" ]]; then
        return 0
      fi
    fi
  done < "$FILTERS_FILE"
  return 1
}

# any_file_in_groups <newline-file-list> <group...>: 0 if any file is in any group.
# Fail-safe: if the filters file is missing, return 0 (run tests) — matches the
# old "no config = always run tests" posture, but only for the Go/frontend gate.
any_file_in_groups() {
  local changed_files="$1"; shift
  [[ -z "$changed_files" ]] && return 1
  [[ ! -f "$FILTERS_FILE" ]] && return 0
  while IFS= read -r file; do
    local g
    for g in "$@"; do
      file_in_group "$file" "$g" && return 0
    done
  done <<< "$changed_files"
  return 1
}

# any_file_under_macdaemon <newline-file-list>: 0 if any line starts with "mac-daemon/".
# The local Swift gate uses this stricter literal prefix test (NOT the mac_daemon
# group) so a ci.yml-only push — which IS in the mac_daemon group for CI's sake —
# does not run `swift test` locally, and the absent-filters-file fail-safe in
# any_file_in_groups can never make the Swift gate over-fire on a non-daemon push.
any_file_under_macdaemon() {
  local files="$1"
  [[ -z "$files" ]] && return 1
  grep -q '^mac-daemon/' <<< "$files"
}

# Check if tests can be skipped
should_skip_tests() {
  # Case 1: No pushed files trigger tests
  local remote_branch
  remote_branch=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null) || remote_branch="origin/main"
  local pushed_files
  pushed_files=$(git diff --name-only "$remote_branch"...HEAD 2>/dev/null)

  if ! any_file_in_groups "$pushed_files" backend frontend; then
    return 0  # No Go/frontend changes, skip tests
  fi

  # Case 2: Tests already passed, no new trigger files since
  local marker=".ai/log/.tests-passed.json"
  if [[ -f "$marker" ]]; then
    local last_tested_commit
    last_tested_commit=$(jq -r '.commit' "$marker" 2>/dev/null)
    if [[ -n "$last_tested_commit" ]] && git rev-parse --verify "$last_tested_commit" >/dev/null 2>&1; then
      local files_since_test
      files_since_test=$(git diff --name-only "$last_tested_commit" HEAD 2>/dev/null)
      if ! any_file_in_groups "$files_since_test" backend frontend; then
        return 0  # Only non-trigger files changed since tests passed
      fi
    fi
  fi

  return 1  # Must run tests
}

# Save test pass marker
save_test_marker() {
  local marker=".ai/log/.tests-passed.json"
  local commit=$(git rev-parse HEAD)
  local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  mkdir -p "$(dirname "$marker")"
  echo "{\"commit\": \"$commit\", \"timestamp\": \"$timestamp\"}" > "$marker"
}

# Swift (mac-daemon) gate: runs `CI=true make test-daemon-local` when the push
# range touches mac-daemon/**. CI marker set so real-Keychain/notification tests
# skip. Blocks push on failure; skips with a warning (exit 0) if Xcode/XCTest is
# unavailable — the intended escape hatch, not a push bypass.
check_swift() {
  cd "$PROJECT_ROOT"  # run_lint's eval'd "cd frontend" leaks into this shell; restore root
  local enabled
  enabled=$(jq -r '.swift.enabled // false' "$CONFIG_FILE")
  if [[ "$enabled" != "true" ]]; then
    return 0
  fi

  local remote_branch changed
  remote_branch=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null) || remote_branch="origin/main"
  changed=$(git diff --name-only "$remote_branch"...HEAD 2>/dev/null) || changed=""

  if ! any_file_under_macdaemon "$changed"; then
    echo "  [swift] OK Skipped (no mac-daemon changes)" >&2
    return 0
  fi

  if ! xcrun --find xctest >/dev/null 2>&1; then
    echo "  [swift] WARN Skipping Swift tests (Xcode/XCTest not found — install full Xcode to gate locally)" >&2
    return 0
  fi

  echo "  [swift] -> mac-daemon swift test (CI=true)" >&2
  if CI=true make test-daemon-local >/dev/null 2>&1; then
    echo "  [swift] OK mac-daemon swift test" >&2
  else
    echo "" >&2
    echo "==============================================================" >&2
    echo "FAILED: mac-daemon Swift tests failed. Fix before pushing." >&2
    echo "  Re-run locally: CI=true make test-daemon-local" >&2
    echo "==============================================================" >&2
    exit 1
  fi
}

# Run test commands
run_tests() {
  cd "$PROJECT_ROOT"  # Ensure correct directory in background
  local enabled=$(jq -r '.test.enabled // false' "$CONFIG_FILE")
  if [[ "$enabled" != "true" ]]; then
    echo "SKIP" > "$TEST_RESULT"
    return
  fi

  # Check if we can skip tests
  if should_skip_tests; then
    echo "  [test] OK Skipped (no trigger files changed since last pass)" >&2
    echo "PASS" > "$TEST_RESULT"
    return
  fi

  local count=$(jq '.test.commands | length' "$CONFIG_FILE")
  if [[ "$count" -eq 0 ]]; then
    echo "SKIP" > "$TEST_RESULT"
    return
  fi

  local failed=0
  for i in $(seq 0 $((count - 1))); do
    local name=$(jq -r ".test.commands[$i].name" "$CONFIG_FILE")
    local cmd=$(jq -r ".test.commands[$i].command" "$CONFIG_FILE")
    local optional=$(jq -r ".test.commands[$i].optional // false" "$CONFIG_FILE")

    echo "  [test] -> $name" >&2
    if eval "$cmd" >/dev/null 2>&1; then
      echo "  [test] OK $name" >&2
    else
      if [[ "$optional" == "true" ]]; then
        echo "  [test] WARN $name (optional)" >&2
      else
        echo "  [test] FAIL $name" >&2
        failed=1
      fi
    fi
  done

  if [[ "$failed" -eq 1 ]]; then
    echo "FAIL" > "$TEST_RESULT"
  else
    save_test_marker
    echo "PASS" > "$TEST_RESULT"
  fi
}

# Allow tests to source this file for unit-testing the pure functions
# (file_in_group / any_file_in_groups) without running the hook body.
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  return 0 2>/dev/null || true
fi

set -e
cd "$PROJECT_ROOT"

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "Warning: No $CONFIG_FILE found, skipping pre-push checks" >&2
  exit 0
fi

# Temp files for parallel execution results
LINT_RESULT=$(mktemp)
TEST_RESULT=$(mktemp)
trap "rm -f $LINT_RESULT $TEST_RESULT" EXIT

echo "==============================================================" >&2
echo "Pre-push: Running checks..." >&2
echo "==============================================================" >&2

check_review_log

# Run lint first (fast, fail early)
run_lint
LINT_STATUS=$(cat "$LINT_RESULT")

if [[ "$LINT_STATUS" == "FAIL" ]]; then
  echo ""
  echo "=============================================================="
  echo "FAILED: Linting failed. Fix issues before pushing."
  echo "=============================================================="
  exit 1
fi

# Swift gate (path-filtered, fast-fail before the heavy Go/frontend suite)
check_swift

# Run tests
run_tests
TEST_STATUS=$(cat "$TEST_RESULT")

echo "" >&2
echo "==============================================================" >&2
echo "Results:" >&2
echo "  Lint:   $LINT_STATUS" >&2
echo "  Tests:  $TEST_STATUS" >&2
echo "==============================================================" >&2

# Determine exit (lint already checked above)
if [[ "$TEST_STATUS" == "FAIL" ]]; then
  echo "" >&2
  echo "FAILED: Tests failed. Fix issues before pushing." >&2
  echo "" >&2
  exit 1
fi

echo "" >&2
echo "OK: All pre-push checks passed." >&2
exit 0
