#!/bin/bash
# Format fully staged files; check partially staged content without changing it.
set -euo pipefail
export GIT_LITERAL_PATHSPECS=1
cd "$(git rev-parse --show-toplevel)"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git diff --cached --name-only --no-renames --diff-filter=ACM -z > "$tmp/paths"

failed=0
while IFS= read -r -d '' file; do
  case "$file" in
    *.go) formatter=go ;;
    frontend/*.ts|frontend/*.tsx|frontend/*.js|frontend/*.jsx|frontend/*.css|frontend/*.json)
      formatter=prettier ;;
    *) continue ;;
  esac
  # Symlinks and submodules contain references rather than source-file contents.
  entry=$(git ls-files --stage -- "$file")
  case "${entry%% *}" in 100644|100755) ;; *) continue ;; esac
  git show ":$file" > "$tmp/staged"
  if [[ "$formatter" == go ]]; then
    gofmt < "$tmp/staged" > "$tmp/formatted"
  else
    if [[ ! -x frontend/node_modules/.bin/prettier ]]; then
      echo "Pre-commit: install frontend dependencies before formatting (make worktree-deps in a linked worktree)." >&2
      exit 1
    fi
    (cd frontend && ./node_modules/.bin/prettier --stdin-filepath "./${file#frontend/}" < "$tmp/staged") > "$tmp/formatted"
  fi
  if cmp -s "$tmp/staged" "$tmp/formatted"; then
    continue
  fi
  if ! git diff --quiet -- "$file"; then
    echo "Pre-commit: staged content needs formatting, but '$file' has unstaged changes. Format and re-stage the intended changes." >&2
    failed=1
    continue
  fi
  cat "$tmp/formatted" > "$file"
  git add -- "$file"
  echo "Pre-commit: formatted $file"
done < "$tmp/paths"

exit "$failed"
