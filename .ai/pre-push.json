{
  "checks": [
    {
      "name": "Backend lint",
      "command": "make lint",
      "groups": [
        "backend"
      ]
    },
    {
      "name": "Frontend lint",
      "command": "cd frontend && bun run lint:code",
      "groups": [
        "frontend"
      ]
    },
    {
      "name": "Frontend formatting",
      "command": "check_frontend_format \"$files\"",
      "groups": [
        "frontend"
      ]
    },
    {
      "name": "Repo hygiene",
      "command": "bash scripts/hooks/repo-hygiene-check.sh",
      "groups": []
    },
    {
      "name": "Spec lint",
      "command": "make spec-lint",
      "groups": [
        "backend",
        "frontend",
        "spec"
      ]
    },
    {
      "name": "Spec coverage",
      "command": "make spec-coverage",
      "groups": [
        "backend",
        "frontend",
        "spec"
      ]
    },
    {
      "name": "Spec drift",
      "command": "make spec-drift",
      "groups": [
        "backend",
        "frontend",
        "spec"
      ]
    },
    {
      "name": "API types drift",
      "command": "make api-types-check",
      "groups": [
        "backend",
        "frontend"
      ]
    },
    {
      "name": "API docs drift",
      "command": "make api-docs-check",
      "groups": [
        "backend"
      ]
    },
    {
      "name": "Contact query drift",
      "command": "make contact-queries-check",
      "groups": [
        "backend"
      ]
    }
  ]
}
