# Personal CRM Environment Configuration
# Copy this file to .env for local development

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL=postgres://crm_user:crm_password@localhost:5432/personal_crm?sslmode=disable

# Docker Compose database settings
POSTGRES_DB=personal_crm
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_PORT=5432

# ===========================================
# API SERVER CONFIGURATION
# ===========================================
PORT=8080
NODE_ENV=development

# ===========================================
# AUTHENTICATION & SESSION
# ===========================================
# Generate a secure random string for production: openssl rand -base64 32
SESSION_SECRET=dev-session-secret-change-in-production-12345

# API authentication key (required for production)
# Generate with: openssl rand -hex 32
API_KEY=dev-api-key-change-in-production

# ===========================================
# AI & EMBEDDINGS
# ===========================================
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ===========================================
# WORKER QUEUE (RIVER)
# ===========================================
# Maximum concurrent River job workers. DB_MAX_CONNS must exceed this
# by at least 3 (River internal connections + HTTP headroom). Default: 10.
# RIVER_WORKER_CONCURRENCY=10

# ===========================================
# EXTERNAL SYNC HOUSEKEEPING
# ===========================================
# Days of external_sync_log rows (one per sync run) the daily sync_log_trim
# job keeps. Range 1-365. Default: 30.
# SYNC_LOG_RETENTION_DAYS=30

# ===========================================
# THE USER
# ===========================================
# The user's own names, comma-separated: each a full name or another name the
# user goes by, such as "First Last, Nickname". The user has no contact record,
# so any feature that needs the user's names reads them here. Spaces around an
# entry and empty entries are ignored. The decision-model masker hides each
# name, and each of its words, as ME, and refuses to build while this holds no
# name: a historical run (crm-admin --judge-start-day and --judge-end-day) and
# crm-admin --scorecard then fail before any content is sent.
# OWN_NAMES=

# ===========================================
# DECISION MODELS
# ===========================================
# Key of the one decision-model method whose judgments may change live state
# (obligations, tasks, flags). Unset or empty designates none: every judgment
# is evidence only.
# DECISION_PRODUCTION_METHOD=

# Path of the name model's Unix socket as the backend sees it. Before masking a
# request, the masker asks the name model for the name spans of every message
# text the span store lacks, and a request the model has not covered is not
# sent. A historical run (crm-admin --judge-start-day and --judge-end-day) and
# crm-admin --scorecard refuse to start while this is unset. The deploy sets it
# in the backend's unit (infra/quadlet/personalcrm-backend.container).
# NAME_MODEL_SOCKET=/run/name-model/name-model.sock

# The name model's score cutoff: a decimal in (0, 1], 0.5 when unset; a span
# scored at the cutoff or more is a name. Every masked method's version and
# the stored spans' key derive from it, so a change makes a rerun judge again
# and ask the model again. A value that is not a number or lies outside the
# range is refused when the configuration loads, so neither the API nor
# crm-admin starts. Set it where both the API and crm-admin load it: a value
# one process sees and the other does not gives them different method
# versions.
# NAME_MODEL_THRESHOLD=0.5

# ===========================================
# TELEGRAM SYNC (OPTIONAL)
# ===========================================
# Get API credentials from https://my.telegram.org/apps
# TELEGRAM_API_ID=your-api-id-here
# TELEGRAM_API_HASH=your-api-hash-here
# Aggregation tuning (defaults shown):
# TELEGRAM_BURST_WINDOW_HOURS=2
# TELEGRAM_REPLY_BRIDGE_HOURS=48
# TELEGRAM_BACKFILL_SINCE=2026-01-01
# TELEGRAM_DISCOVERY_MIN_MESSAGES=3
# TELEGRAM_GROUP_MAX_MEMBERS=10
# ===========================================
# WHATSAPP SYNC (OPTIONAL)
# ===========================================
# Pairing is a linked-device QR / phone-code flow from the settings page; there
# are no API credentials to configure. Aggregation and gating tuning
# (defaults shown):
# WHATSAPP_BURST_WINDOW_HOURS=2
# WHATSAPP_REPLY_BRIDGE_HOURS=48
# WHATSAPP_DISCOVERY_MIN_MESSAGES=3
# WHATSAPP_GROUP_MAX_MEMBERS=10
# The 2026-01-01 backfill floor and the 365-day history request are NOT
# configurable: both are one-way, so they are Go constants in
# backend/internal/whatsapp.

# ===========================================
# GOOGLE
# ===========================================
# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# ===========================================
# TODOIST
# ===========================================
TODOIST_CLIENT_ID=your-client-id-here
TODOIST_CLIENT_SECRET=your-client-secret-here
TODOIST_REDIRECT_URL=http://localhost:8080/api/v1/auth/todoist/callback

# Token Encryption Key (32-byte hex string)
TOKEN_ENCRYPTION_KEY=your-64-char-hex-key-here

# ===========================================
# BACKUP CONFIGURATION
# ===========================================
BACKUP_PATH=/path/to/your/backup/directory
HOME_SERVER_HOST=your-home-server.local
HOME_SERVER_USER=backup-user

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Log level: trace, debug, info, warn, error, fatal, panic
LOG_LEVEL=info

# Set to 'true' to enable debug logging (deprecated, use LOG_LEVEL instead)
DEBUG=false

# Set to 'true' to enable CORS for all origins (dev only)
CORS_ALLOW_ALL=true

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000

# ===========================================
# FEATURE FLAGS
# ===========================================
# Enable experimental features
ENABLE_VECTOR_SEARCH=false
ENABLE_TELEGRAM_SYNC=false
ENABLE_CALENDAR_SYNC=false
# WhatsApp linked-device sync. Requires ENABLE_EXTERNAL_SYNC=true — the
# discovery / import-candidate / contact-method-enrichment stack it depends on
# lives behind that flag, so startup fails when this is on and that is off.
# One-way: external sync on its own is a normal configuration.
ENABLE_WHATSAPP_SYNC=false
ENABLE_EXTERNAL_SYNC=true

# Frontend feature flags (must match backend settings)

# ===========================================
# DECISION MODELS
# ===========================================
# Routes for the compared decision-model methods. A method whose key is
# empty is unavailable; every method receives masked content only.
# OpenRouter serves clef-masked and clef-masked-reasoned.
OPENROUTER_API_KEY=
# Venice's decisions API serves jev-masked.
VENICE_API_KEY=

# Langfuse project for extraction runs, separate from the project that
# LANGFUSE_HOST / LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY name.
# LANGFUSE_EXTRACTION_HOST=http://your-langfuse-host
LANGFUSE_EXTRACTION_PUBLIC_KEY=
LANGFUSE_EXTRACTION_SECRET_KEY=

# ===========================================
# DEPLOYMENT (Pi)
# ===========================================
# Hostname of your Raspberry Pi (for setup-pi.sh, backup-db.sh, restore-db.sh)
# Must be exported to environment, not just set in .env:
#   export PI_HOST=mypi && make setup-pi
# Or inline: PI_HOST=mypi make setup-pi
# PI_HOST=raspberry-pi

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
# Frontend-specific vars (NEXT_PUBLIC_*) are in frontend/.env.example
# Copy to frontend/.env.local for local development

# ===========================================
# HOST ALIASES (dev-machine only; never committed)
# ===========================================
# Host aliases are deliberately NOT committed anywhere in the repo (privacy rule:
# no hostnames in tracked artifacts). Set STAGING_HOST here (this file's real
# counterpart, .env, is gitignored) or export it in your shell. Required by
# `make staging-reset`, `make tours`, and scripts/admin/setup-staging-reseed-host.sh.
# STAGING_HOST=your-staging-host
