# PersonalCRM PostgreSQL (rootless Podman Quadlet) -- replaces the Docker
# Compose postgres + personalcrm-database.service. Generates
# personalcrm-database.service via the podman user-generator.
#
# pgvector/pgvector:pg16 (same image as today). max_connections=200 matches the
# dev/CI ceiling. init-db.sql bootstraps extensions on a FRESH volume (belt-and-
# suspenders; the dump also carries CREATE EXTENSION).
[Unit]
Description=PersonalCRM PostgreSQL Database (Podman, rootless)
After=crm-network.service
Requires=crm-network.service

[Container]
ContainerName=crm-postgres
Image=docker.io/pgvector/pgvector:pg16
Network=crm.network
Volume=personalcrm-db.volume:/var/lib/postgresql/data
Volume=/srv/personalcrm/infra/init-db.sql:/docker-entrypoint-initdb.d/init-db.sql:ro
EnvironmentFile=/srv/personalcrm/.env
Environment=POSTGRES_DB=personal_crm
Environment=POSTGRES_USER=crm_user
Exec=postgres -c max_connections=200
# Published to loopback only for host-side tooling (psql, backups). The backend
# connects over the crm network via the `crm-postgres` DNS name, not this port.
PublishPort=127.0.0.1:5432:5432
# No HealthCmd on purpose: this rootless podman-static runtime runs with
# cgroupManager=cgroupfs + eventLogger=file, so podman never creates the
# transient systemd timer that executes a container healthcheck. A declared
# HealthCmd would therefore never run -- the container would report "(starting)"
# forever despite a perfectly healthy DB. Liveness is covered by Restart=always
# (below) and the deploy health-gate, which probes the backend API over the DB.

[Service]
Restart=always
RestartSec=10s
TimeoutStopSec=30s

[Install]
WantedBy=default.target
