# Required. Left empty on purpose: an unedited copy makes the scripts fail with
# "<name> is required" instead of uploading anywhere.
# rclone remote name from /var/lib/personalcrm/.config/rclone/rclone.conf
BACKUP_REMOTE=
# B2 bucket name
BACKUP_BUCKET=
# age public key (age1...) from `age-keygen -y` on the identity file
AGE_RECIPIENT=

# Defaults; change only if the deployment differs.
AGE_IDENTITY_FILE=/var/lib/personalcrm/.config/personalcrm-backup/age.key
CRM_ENV_FILE=/srv/personalcrm/.env
PG_EXEC='podman exec -i crm-postgres'
PG_USER=crm_user
PG_DB=personal_crm
VERIFY_DB=personal_crm_verify
BACKUP_MAX_AGE_HOURS=36
VERIFY_CONTACT_TOLERANCE_PCT=5
ZSTD_LEVEL=3
