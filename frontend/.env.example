# Frontend Environment Configuration
# Copy this file to .env.local for local development

# API URL (required for local development)
# Points to the backend server. Leave empty in production if using
# a reverse proxy (e.g., Caddy) for same-origin requests.
NEXT_PUBLIC_API_URL=http://localhost:8080

# API Authentication
# Must match the API_KEY in backend .env
# Generate with: openssl rand -hex 32
NEXT_PUBLIC_API_KEY=your-api-key-here

# Git Commit Hash (optional, auto-injected at build time)
# Used to display the current deployment version in the Settings page
# Typically set by CI/CD: NEXT_PUBLIC_COMMIT_HASH=$(git rev-parse HEAD)
# NEXT_PUBLIC_COMMIT_HASH=

# GitHub Repository (optional, enables commit hash links)
# Format: owner/repo (e.g., spengrah/PersonalCRM)
# When set, the commit hash in Settings becomes a clickable link to GitHub
# NEXT_PUBLIC_GITHUB_REPO=

# Build Version (optional, auto-injected at build time)
# CalVer format: YYYY.M.D (e.g., 2026.1.13)
# Typically set by CI/CD: NEXT_PUBLIC_BUILD_VERSION=$(date +"%Y.%-m.%-d")
# NEXT_PUBLIC_BUILD_VERSION=
